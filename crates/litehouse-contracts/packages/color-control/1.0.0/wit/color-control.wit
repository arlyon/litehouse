package litehouse:color-control@1.0.0;

interface types {
  use litehouse:descriptor/types@1.0.0.{facet-descriptor};
  use litehouse:errors/types@1.0.0.{core-error, retry-advice};
  use litehouse:receipt/types@1.0.0.{command-receipt, deduplication-guarantee, operation-kind};
  use litehouse:state/types@1.0.0.{availability, gap, hydration-barrier, observation-meta, quality};

  type decimal = string;

  enum color-model {
    hue-saturation,
    cie-xy,
    color-temperature,
    calibrated-rgb,
    uncalibrated-rgb,
    native-white-channels,
  }

  enum operation {
    set-color,
    step-color,
    move-color,
    stop,
  }

  enum state-field {
    current-color,
    target-color,
    active-model,
  }

  enum event-kind {
    state-observation,
  }

  record hue-saturation {
    hue-degrees: decimal,
    saturation-ratio: decimal,
  }

  record cie-xy {
    x: decimal,
    y: decimal,
  }

  record color-temperature {
    kelvin: decimal,
  }

  record rgb-channels {
    red: decimal,
    green: decimal,
    blue: decimal,
  }

  record calibrated-rgb {
    channels: rgb-channels,
    color-space: string,
  }

  record white-channels {
    white: option<decimal>,
    cold-white: option<decimal>,
    warm-white: option<decimal>,
  }

  variant color-value {
    hue-saturation(hue-saturation),
    cie-xy(cie-xy),
    color-temperature(color-temperature),
    calibrated-rgb(calibrated-rgb),
    uncalibrated-rgb(rgb-channels),
    native-white-channels(white-channels),
  }

  record model-range {
    model: color-model,
    minimum: list<decimal>,
    maximum: list<decimal>,
    gamut: option<string>,
    native-step: option<decimal>,
  }

  record operation-support {
    operation: operation,
    kind: operation-kind,
    deduplication: deduplication-guarantee,
    default-deadline-milliseconds: u32,
    maximum-deadline-milliseconds: u32,
  }

  record color-descriptor {
    common: facet-descriptor,
    models: list<color-model>,
    operations: list<operation>,
    state-fields: list<state-field>,
    events: list<event-kind>,
    ranges: list<model-range>,
    operation-support: list<operation-support>,
  }

  record state {
    meta: observation-meta,
    availability: availability,
    quality: option<quality>,
    current: option<color-value>,
    target: option<color-value>,
    active-model: option<color-model>,
  }

  record transition {
    duration-milliseconds: u64,
  }

  record set-request {
    color: color-value,
    transition: option<transition>,
  }

  record step-request {
    delta: color-value,
    transition: option<transition>,
  }

  record move-request {
    rate-per-second: color-value,
  }

  variant operation-intent {
    set-color(set-request),
    step-color(step-request),
    move-color(move-request),
    stop,
  }

  record operation-receipt {
    operation: operation-intent,
    receipt: command-receipt,
  }

  variant contract-error-detail {
    unsupported-model(color-model),
    out-of-range(color-model),
    out-of-gamut(color-model),
    unrepresentable-conversion(color-model),
    lossy-conversion(color-model),
    invalid-transition,
    unsupported-operation(operation),
  }

  record error {
    inner: core-error,
    detail: option<contract-error-detail>,
    retry: retry-advice,
    message: option<string>,
    error-id: string,
  }

  variant state-event {
    snapshot(state),
    caught-up(hydration-barrier),
    observation(state),
    gap(gap),
  }

}

interface capability {
  use litehouse:receipt/types@1.0.0.{request-context};
  use litehouse:state/types@1.0.0.{resume-position, resume-receipt, resume-request};
  use types.{color-descriptor, error, move-request, operation-receipt, set-request, state, state-event, step-request};

  resource state-subscription {
    next: async func(context: request-context) -> result<state-event, error>;
    resume: async func(context: request-context, request: resume-request) -> result<resume-receipt, error>;
  }

  describe: async func(context: request-context) -> result<color-descriptor, error>;
  query: async func(context: request-context) -> result<state, error>;
  subscribe: async func(context: request-context, resume: option<resume-position>) -> result<state-subscription, error>;
  set-color: async func(context: request-context, request: set-request) -> result<operation-receipt, error>;
  step-color: async func(context: request-context, request: step-request) -> result<operation-receipt, error>;
  move-color: async func(context: request-context, request: move-request) -> result<operation-receipt, error>;
  stop: async func(context: request-context) -> result<operation-receipt, error>;
}

world provider {
  export capability;
}

world consumer {
  import capability;
}

package litehouse:measurement@1.0.0;

interface types {
  use litehouse:descriptor/types@1.0.0.{facet-descriptor};
  use litehouse:errors/types@1.0.0.{core-error, retry-advice};
  use litehouse:quantity/types@1.0.0.{native-representation, profile-id, quantity};
  use litehouse:state/types@1.0.0.{availability, gap, hydration-barrier, observation-meta, quality};

  enum measurement-kind {
    instantaneous,
    total,
    total-increasing,
  }

  enum state-field {
    current,
    native-representation,
  }

  enum event-kind {
    observation,
  }

  record measurement-bounds {
    minimum: option<quantity>,
    maximum: option<quantity>,
    resolution: option<quantity>,
    step: option<quantity>,
    tolerance: option<quantity>,
  }

  record measurement-descriptor {
    common: facet-descriptor,
    profile: profile-id,
    kind: measurement-kind,
    state-fields: list<state-field>,
    events: list<event-kind>,
    bounds: measurement-bounds,
  }

  record state {
    meta: observation-meta,
    availability: availability,
    quality: option<quality>,
    current: option<quantity>,
    native: option<native-representation>,
  }

  record profile-mismatch {
    expected: profile-id,
    actual: profile-id,
  }

  variant contract-error-detail {
    unsupported-profile(profile-id),
    unsupported-unit(string),
    invalid-value,
    non-finite-value,
    dimension-profile-mismatch(profile-mismatch),
    affine-misuse,
    overflow,
    inexact-result-requires-quantization,
    out-of-range-source-data,
  }

  record error {
    inner: core-error,
    detail: option<contract-error-detail>,
    retry: retry-advice,
    message: option<string>,
    error-id: string,
  }

  variant state-event {
    snapshot(state),
    caught-up(hydration-barrier),
    observation(state),
    gap(gap),
  }
}

interface capability {
  use litehouse:receipt/types@1.0.0.{request-context};
  use litehouse:state/types@1.0.0.{resume-position, resume-receipt, resume-request};
  use types.{error, measurement-descriptor, state, state-event};

  resource state-subscription {
    next: async func(context: request-context) -> result<state-event, error>;
    resume: async func(context: request-context, request: resume-request) -> result<resume-receipt, error>;
  }

  describe: async func(context: request-context) -> result<measurement-descriptor, error>;
  query: async func(context: request-context) -> result<state, error>;
  subscribe: async func(context: request-context, resume: option<resume-position>) -> result<state-subscription, error>;
}

world provider {
  export capability;
}

world consumer {
  import capability;
}

        "id": "set_light",
        "version": 1,
        "selector": {
          "provider_instance_id": "22222222222222222222222222222222",
          "facet_key": "light",
          "contract": {
            "namespace": "litehouse",
            "package": "on-off",
            "interface": "capability",
            "major": 1
          }
        },
        "value": true
      },
      { "kind": "end", "id": "end_success", "version": 1, "outcome": "success" },
      { "kind": "end", "id": "end_noop", "version": 1, "outcome": "noop" },
      { "kind": "end", "id": "end_unknown", "version": 1, "outcome": "unknown" },
      { "kind": "end", "id": "end_error", "version": 1, "outcome": "error" }

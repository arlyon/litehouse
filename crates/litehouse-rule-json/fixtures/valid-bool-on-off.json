  },
  "rule_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "revision": 7,
  "semantic": {
    "name": "Observed boolean controls a switch",
    "description": "Plan an absolute On/Off set when the observed value is true.",
    "locks": {
      "compiler": "litehouse:rule-compiler@1",
      "quantity_catalog": "litehouse:quantity-catalog@1"
    },
    "limits": {
      "max_nodes": 128,
      "max_edges": 256,
      "max_depth": 32
    },
    "trigger": {
      "kind": "state_observation",
      "id": "trigger",
      "version": 1,
      "selector": {
        "provider_instance_id": "11111111111111111111111111111111",
        "facet_key": "presence",
        "contract": {
          "namespace": "example",
          "package": "presence",
          "interface": "state",
          "major": 1
        }
      },
      "mode": "value_change",
      "initial": "ignore"

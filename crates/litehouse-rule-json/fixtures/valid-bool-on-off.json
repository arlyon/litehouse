      { "id": "e_compare_result", "from": { "node": "compare", "port": "result" }, "to": { "node": "branch", "port": "condition" }, "order": 0 },
      { "id": "e_true_set", "from": { "node": "branch", "port": "true" }, "to": { "node": "set_light", "port": "in" }, "order": 0 },
      { "id": "e_set_success", "from": { "node": "set_light", "port": "next" }, "to": { "node": "end_success", "port": "in" }, "order": 0 },
